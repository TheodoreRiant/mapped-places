#: src/Admin/SettingsPage.php:189
#: src/Admin/SettingsPage.php:414
msgid "Map configuration"
msgstr "Réglages de la carte"

#: src/Admin/SettingsPage.php:190
msgid "Map settings"
msgstr "Réglages carte"

#: src/Admin/SettingsPage.php:245
msgid "Unrecognised settings: the default values have been restored."
msgstr "Réglages non reconnus : les valeurs par défaut ont été restaurées."

#: src/Admin/SettingsPage.php:256
msgid "Unknown basemap: the “each page decides” setting was kept."
msgstr "Fond de carte inconnu : le réglage « chaque page décide » a été conservé."

#: src/Admin/SettingsPage.php:278
msgid "Invalid tile URL: it must start with https:// and contain {z}, {x} and {y}. It was not saved."
msgstr "URL de tuiles invalide : elle doit commencer par https:// et contenir {z}, {x} et {y}. Elle n’a pas été enregistrée."

#: src/Admin/SettingsPage.php:298
msgid "The “Custom URL” basemap needs a tile URL: the map will use the keyless Positron basemap in the meantime."
msgstr "Le fond « URL personnalisée » nécessite une URL de tuiles : la carte utilisera le fond Positron sans clé en attendant."

#: src/Admin/SettingsPage.php:310
msgid "This basemap requires an API key: the map will use the keyless Positron basemap until the key is set."
msgstr "Ce fond de carte exige une clé API : la carte utilisera le fond Positron sans clé tant que la clé n’est pas renseignée."

#: src/Admin/SettingsPage.php:324
msgid "Settings saved."
msgstr "Réglages enregistrés."

#: src/Admin/SettingsPage.php:372
msgid "Map:"
msgstr "Carte :"

#: src/Admin/SettingsPage.php:375
msgid "Open the map settings"
msgstr "Ouvrir les réglages de la carte"

#: src/Admin/SettingsPage.php:388
msgid "the selected basemap requires an API key that is not set; the keyless Positron basemap is shown instead."
msgstr "le fond de carte choisi exige une clé API qui n’est pas renseignée ; le fond Positron sans clé est affiché à la place."

#: src/Admin/SettingsPage.php:390
msgid "the custom tile URL is missing or invalid; the keyless Positron basemap is shown instead."
msgstr "l’URL de tuiles personnalisée est absente ou invalide ; le fond Positron sans clé est affiché à la place."

#: src/Admin/SettingsPage.php:392
msgid "the requested basemap does not exist; the keyless Positron basemap is shown instead."
msgstr "le fond de carte demandé n’existe pas ; le fond Positron sans clé est affiché à la place."

#: src/Admin/SettingsPage.php:403
msgid "You do not have the required permissions."
msgstr "Vous n’avez pas les droits nécessaires."

#: src/Admin/SettingsPage.php:421
msgid "Basemap"
msgstr "Fond de carte"

#: src/Admin/SettingsPage.php:425
msgid "Basemap applied to the site"
msgstr "Fond appliqué au site"

#: src/Admin/SettingsPage.php:431
msgid "— Let each map decide (block, Elementor or shortcode setting) —"
msgstr "— Laisser chaque carte décider (réglage du bloc, d’Elementor ou du shortcode) —"

#: src/Admin/SettingsPage.php:440
msgid "Each map (block, Elementor widget or shortcode) stores its own basemap. Choosing a value here forces it on every map of the site, without reopening each page."
msgstr "Chaque carte (bloc, widget Elementor ou shortcode) enregistre son propre fond de carte. Choisir une valeur ici l’impose à toutes les cartes du site, sans avoir à rouvrir chaque page."

#: src/Admin/SettingsPage.php:447
msgid "Provider API key"
msgstr "Clé API du fournisseur"

#. translators: %s: nom de la constante PHP
#: src/Admin/SettingsPage.php:463
#, php-format
msgid "The key is set by the %s constant in wp-config.php: it takes precedence and cannot be changed here."
msgstr "La clé est définie par la constante %s dans wp-config.php : elle a la priorité et ne peut pas être modifiée ici."

#: src/Admin/SettingsPage.php:470
msgid "Only needed for basemaps marked “key required”. The IGN and OpenStreetMap basemaps work without a key. Since 2026, CARTO basemaps (Positron, Voyager, Dark Matter) require a key: without it, their tiles are stamped “API KEY REQUIRED”."
msgstr "Nécessaire uniquement pour les fonds marqués « clé requise ». Les fonds Plan IGN et OpenStreetMap fonctionnent sans clé. Depuis 2026, les fonds CARTO (Positron, Voyager, Dark Matter) exigent une clé : sans elle, leurs tuiles portent la mention « API KEY REQUIRED »."

#. translators: %s: nom de la constante PHP
#: src/Admin/SettingsPage.php:476
#, php-format
msgid "To avoid storing the key in the database, you can also define it in wp-config.php: %s"
msgstr "Pour ne pas stocker la clé en base, on peut aussi la définir dans wp-config.php : %s"

#: src/Admin/SettingsPage.php:483
msgid "Good to know:"
msgstr "À savoir :"

#: src/Admin/SettingsPage.php:484
msgid "a tile key is always visible in the page source, since it is the visitor's browser that sends it to the provider. Restrict it to your site's domain in your provider account."
msgstr "une clé de tuiles est forcément visible dans le code source des pages, car c’est le navigateur du visiteur qui la transmet au fournisseur. Restreignez-la au domaine de votre site dans votre compte fournisseur."

#: src/Admin/SettingsPage.php:490
msgid "Custom provider"
msgstr "Fournisseur personnalisé"

#: src/Admin/SettingsPage.php:492
msgid "Only fill this in if you chose the “Custom URL” basemap above."
msgstr "À remplir seulement si vous avez choisi le fond « URL personnalisée » ci-dessus."

#: src/Admin/SettingsPage.php:497
msgid "Tile URL"
msgstr "URL des tuiles"

#: src/Admin/SettingsPage.php:508
msgid "Accepted tokens: {z}, {x}, {y} (required), {s} for subdomains, {r} for @2x tiles, and {key}, replaced by the API key above."
msgstr "Jetons acceptés : {z}, {x}, {y} (obligatoires), {s} pour les sous-domaines, {r} pour la version @2x, et {key} qui sera remplacé par la clé API ci-dessus."

#: src/Admin/SettingsPage.php:514
msgid "Attribution"
msgstr "Attribution"

#: src/Admin/SettingsPage.php:523
msgid "Legal notice shown at the bottom of the map. <a> links are allowed."
msgstr "Mention légale affichée en bas de la carte. Les liens <a> sont autorisés."

#: src/Admin/SettingsPage.php:532
msgid "Current state"
msgstr "État actuel"

#: src/Admin/SettingsPage.php:536
msgid "API key"
msgstr "Clé API"

#: src/Admin/SettingsPage.php:539
msgid "no key saved"
msgstr "aucune clé enregistrée"

#: src/Admin/SettingsPage.php:543
msgid "(set in wp-config.php)"
msgstr "(définie dans wp-config.php)"

